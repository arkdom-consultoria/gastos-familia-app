# Backend Environment Variables - Gastos Família
# Copie este arquivo para .env e preencha com seus valores reais

# ============================================
# SERVIDOR
# ============================================
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://10d18506-ce7e-4140-8bd7-f2a481b1f4e2-00-1vgi92tf28ln5.spock.replit.dev

# ============================================
# SUPABASE (Obrigatório)
# ============================================
# Obter em: https://app.supabase.com → Settings → API
# Copiar "Project URL" e "Service Key"
SUPABASE_URL=https://zudgocuhhhtbczyjbfhf.supabase.co
SUPABASE_SERVICE_KEY=seu_service_key_completo_aqui

# ============================================
# STRIPE (Obrigatório para pagamentos)
# ============================================
# Obter em: https://dashboard.stripe.com → Developers → API Keys
# Usar as chaves de teste (pk_test_ e sk_test_)
STRIPE_PUBLISHABLE_KEY=pk_test_seu_key_completo_aqui
STRIPE_SECRET_KEY=sk_test_seu_key_completo_aqui
STRIPE_WEBHOOK_SECRET=whsec_seu_webhook_secret_aqui

# ============================================
# EMAIL (Para notificações)
# ============================================
# Usar Gmail App Password (não sua senha normal)
# Obter em: https://myaccount.google.com/apppasswords
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_app_password_16_caracteres
