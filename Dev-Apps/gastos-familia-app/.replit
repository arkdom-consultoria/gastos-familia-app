run = "cd backend && npm start"
modules = ["nodejs-20"]
entrypoint = "backend/server.js"

[nix]
channel = "stable-24_05"

[env]
NODE_ENV = "production"
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "cd backend && npm start"]

[[ports]]
localPort = 5000
externalPort = 80
